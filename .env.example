# SQLite for local demo. Switch to PostgreSQL in production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/trailwise?schema=public"
DATABASE_URL="file:./dev.db"

# Optional: used to encrypt an AI key stored in an httpOnly cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Optional hosted default. Prefer this over a UI-entered key in production.
# Never commit a real key. The app works without AI.
# AI_API_KEY=
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
